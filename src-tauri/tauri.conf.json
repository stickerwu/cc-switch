{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "package": {
    "productName": "CC Switch",
    "version": "3.17.0"
  },
  "build": {
    "distDir": "../dist",
    "devPath": "http://localhost:3000",
    "beforeDevCommand": "pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run build:renderer"
  },
  "tauri": {
    "allowlist": {
      "all": true,
      "shell": {
        "all": true,
        "open": ".*",
        "scope": [
          {
            "name": "cc-switch-links",
            "cmd": "xdg-open",
            "args": true
          },
          {
            "name": "cc-switch-paths",
            "cmd": "open",
            "args": true
          }
        ]
      },
      "protocol": {
        "asset": true,
        "assetScope": []
      }
    },
    "bundle": {
      "active": true,
      "targets": ["deb"],
      "identifier": "com.ccswitch.desktop",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "windows": {
        "wix": {
          "template": "wix/per-user-main.wxs"
        }
      },
      "macOS": {
        "minimumSystemVersion": "12.0"
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "",
        "titleBarStyle": "Overlay",
        "width": 1000,
        "height": 650,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: http:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    },
    "systemTray": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false
    }
  }
}
